# Supabase (Settings > API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Groq (groqcloud.com > API Keys)
GROQ_API_KEY=gsk_your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Auth
JWT_SECRET_KEY=change-this-to-a-long-random-string

# CORS: comma-separated origins. Use your Vercel URL in production.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Optional RAG bonus over precedent programs
USE_RAG=false

# Test harness — set to true in local dev only to enable POST /simulate/evaluate.
# This endpoint runs the evaluator without touching the database.
# Never enable in production — it would expose an unauthenticated AI endpoint.
ENABLE_SIMULATE=false

# GitHub OAuth app credentials (for per-user GitHub account linking)
# Register an OAuth App at github.com/settings/developers → "New OAuth App"
# Callback URL must match exactly: http://localhost:8000/auth/github/callback (local)
#   or https://your-backend.railway.app/auth/github/callback (prod)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:8000/auth/github/callback

# Frontend URL — where the backend redirects after OAuth completes
FRONTEND_URL=http://localhost:5173
