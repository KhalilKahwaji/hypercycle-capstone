# Supabase (Settings > API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Groq (groqcloud.com > API Keys)
GROQ_API_KEY=gsk_your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Auth
JWT_SECRET_KEY=change-this-to-a-long-random-string

# CORS: comma-separated origins. Use your Vercel URL in production.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Optional RAG bonus over precedent programs
USE_RAG=false

# Mission RAG: ground program generation in real missions retrieved from the
# Supabase `missions` table (pgvector). Default ON; set to false to fall back to
# precedents.py. If retrieval fails for any reason, generation falls back anyway.
USE_MISSION_RAG=true
# Gemini API key for embedding the retrieval query (aistudio.google.com/apikey).
GEMINI_API_KEY=your-gemini-api-key
# Embedding model for queries. MUST match the model that populated missions.embedding
# (the committed ingest_missions.py used models/gemini-embedding-001 at 768 dims).
MISSION_EMBED_MODEL=models/gemini-embedding-001

# Test harness — set to true in local dev only to enable POST /simulate/evaluate.
# This endpoint runs the evaluator without touching the database.
# Never enable in production — it would expose an unauthenticated AI endpoint.
ENABLE_SIMULATE=false

# GitHub OAuth app credentials (for per-user GitHub account linking)
# Register an OAuth App at github.com/settings/developers → "New OAuth App"
# Callback URL must match exactly: http://localhost:8000/auth/github/callback (local)
#   or https://your-backend.railway.app/auth/github/callback (prod)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:8000/auth/github/callback

# Frontend URL — where the backend redirects after OAuth completes
FRONTEND_URL=http://localhost:5173

# ----- Multi-LLM routing (experimental — OFF by default) -----
# false (default): every LLM call uses Groq exactly as before.
# true: hard tasks (program generation, day adaptation, evaluation of
#   day >= COMPLEXITY_THRESHOLD_DAY) -> Anthropic Claude;
#   easy tasks (file analysis, early-day evaluation) -> local Ollama.
# Any backend failure falls back to Groq automatically.
# Requires: pip install anthropic (see requirements.txt) + a running Ollama.
USE_MULTI_LLM=false
# ANTHROPIC_API_KEY=sk-ant-your-key
# ANTHROPIC_MODEL=claude-opus-4-8
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.2
# COMPLEXITY_THRESHOLD_DAY=8
